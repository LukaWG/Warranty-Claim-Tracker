# EXAMPLE ONLY — copy to .env (gitignored) and fill in real values.
# This lists every variable the app actually reads from process.env.


# What the running app actually connects with at runtime.
# docker-compose.yaml derives this itself at runtime from BETTER_AUTHPW
# below, overriding whatever default is baked into the app image — this
# entry only matters for `npm run dev` / running the Next.js app outside
# Docker.
AUTH_DATABASE_URL=postgresql://adminuser:CHANGE-ME@localhost:51214/warranty_claim_tracker

# docker-compose.yaml only: the auth (Postgres) container's own password.
# Leave unset to use the default "Password", which matches what's baked into
# the app image's AUTH_DATABASE_URL. Only set this if you also rebuilt the
# app image with a matching --build-arg AUTH_DATABASE_URL — the two are not
# linked automatically, so a mismatch here breaks the app's DB connection.
BETTER_AUTHPW=

# --- Auth -------------------------------------------------------------------

# Session signing secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE-ME

# Public URL users reach the app on (scheme + host, no trailing slash).
# Must exactly match the browser's address bar / the registered Microsoft
# redirect URI — a mismatch causes INVALID_ORIGIN or SSO redirect failures.
BETTER_AUTH_URL=http://localhost:3000

# Microsoft SSO — leave blank/false if unused. All three are runtime secrets;
# NEXT_PUBLIC_ENABLE_MICROSOFT_SSO/NEXT_PUBLIC_AUTO_LOGIN_MICROSOFT_SSO below
# control whether the button/auto-redirect even appears (build-time).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" allows ANY Microsoft tenant to attempt sign-in (only the
# @hendy-group.com email check backstops it) — set to the real Entra tenant
# GUID to restrict sign-in to that tenant.
MICROSOFT_TENANT_ID=common

# --- Data API (server-only — the browser never talks to this directly,
#     only this app's own /api/data proxy does) ------------------------------

DATA_API_URL=http://localhost:5001
# Must match INTERNAL_API_KEY in the warrantyRepairData deployment's env.
DATA_API_KEY=

# --- Build-time only (NEXT_PUBLIC_*) -----------------------------------------
# Baked into the client bundle when the image is built (see Dockerfile ARGs /
# docker-compose build.args). Changing these requires a rebuild — setting
# them in a running container's environment has no effect.

NEXT_PUBLIC_BASE_PATH=/
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_TIMEOUT=30000
NEXT_PUBLIC_ENABLE_MICROSOFT_SSO=false
NEXT_PUBLIC_AUTO_LOGIN_MICROSOFT_SSO=false
