{
  "name": "Site",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Site location name"
    },
    "code": {
      "type": "string",
      "description": "Site code or identifier"
    },
    "brands": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of brand names available at this site"
    },
    "hourly_rate": {
      "type": "number",
      "description": "Default hourly rate for this site"
    },
    "brand_hourly_rates": {
      "type": "object",
      "description": "Per-brand hourly rates, keyed by brand name"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this site is active"
    }
  },
  "required": [
    "name"
  ]
}