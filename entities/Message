{
  "name": "Message",
  "type": "object",
  "properties": {
    "claim_id": {
      "type": "string",
      "description": "ID of the related warranty claim"
    },
    "wip_number": {
      "type": "string",
      "description": "WIP number for display reference"
    },
    "target_site": {
      "type": "string",
      "description": "Site to send the message to (all processors at this site)"
    },
    "subject": {
      "type": "string",
      "description": "Message subject"
    },
    "body": {
      "type": "string",
      "description": "Message body"
    },
    "sender_email": {
      "type": "string",
      "description": "Email of the sender"
    },
    "sender_name": {
      "type": "string",
      "description": "Display name of the sender"
    },
    "parent_message_id": {
      "type": "string",
      "description": "ID of the parent message if this is a reply"
    },
    "is_reply": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is a reply to another message"
    },
    "image_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Attached image URLs"
    }
  },
  "required": [
    "claim_id",
    "wip_number",
    "target_site",
    "body",
    "sender_email"
  ]
}