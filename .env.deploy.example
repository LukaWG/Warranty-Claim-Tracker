# EXAMPLE ONLY — copy to .env next to docker-compose.yaml on the deploy
# machine, fill in real values, then: docker compose pull && docker compose up -d
#
# This is the minimal set docker-compose.yaml needs at runtime. It does NOT
# include NEXT_PUBLIC_* vars — those are baked into the image at build time
# (see .github/workflows/deploy.yml) and can't be changed here.

BETTER_AUTH_SECRET=      # required — generate with: openssl rand -base64 32
DATA_API_KEY=            # required — must match the Data API's INTERNAL_API_KEY

BETTER_AUTHPW=           # Postgres password; defaults to "Password" if left unset
BETTER_AUTH_URL=http://localhost:3000     # public URL this app is reached at
DATA_API_URL=http://localhost:5001        # Data API base URL as reached from this host

# Microsoft SSO — leave blank if this deployment doesn't use it.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
